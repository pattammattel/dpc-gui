

/* Form Inputs */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QDateEdit, QTimeEdit {
    padding: 4px;  /* was 6px */
    border: 1px solid #ccc;
    border-radius: 3px;
    background: white;
    min-height: 20px;
}

/* Text fields */
QTextEdit, QPlainTextEdit {
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 4px;
    font-family: monospace;
    background: white;
}

/* Buttons */
QPushButton {
    background-color: #005ea2;
    color: white;
    padding: 6px 12px;  /* was 8px 16px */
    border: none;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #004080;
}

QPushButton:pressed {
    background-color: #003e6b;
}

